# Copy to .env and fill in. Validated at boot by src/lib/env.ts (set SKIP_ENV_VALIDATION=1 only for CI builds).

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Runtime connection (pooled in production: Supabase pooler / pgbouncer, port 6543).
DATABASE_URL=postgresql://gearage:gearage@localhost:5432/gearage
# Direct connection, used ONLY by Prisma migrations (Supabase: port 5432, not the pooler).
DIRECT_URL=postgresql://gearage:gearage@localhost:5432/gearage

# Bearer secret for /api/cron/*. Generate: openssl rand -base64 48
CRON_SECRET=change-me-to-a-random-string-of-32-chars-or-more
