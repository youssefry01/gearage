# Copy to .env (local development) and fill in. Validated at boot by src/lib/env.ts.
# Set SKIP_ENV_VALIDATION=1 only for CI builds.
#
# ENV FILES (all gitignored except this one):
#   .env             local development. Loaded by Next.js and by Prisma (prisma.config.ts).
#   .env.production  optional, LOCAL-ONLY reference for a future production setup (for example, running a production
#                    build on your machine). Real production values live in Vercel > Project Settings > Environment
#                    Variables and are never committed. Note: `next build` / `next start` load this file automatically.
#
# `prisma migrate dev`, `prisma db push|reset|seed|execute` and `prisma studio` REFUSE to run unless the database
# host is local (see prisma/guard.ts). Production is migrated with `prisma migrate deploy` only.

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Database: LOCAL PostgreSQL (your own install, or Docker: `docker compose up -d`, which is optional) ---
# Create it once, for example:  createdb gearage   (or via pgAdmin / psql: CREATE DATABASE gearage;)
# Adjust user, password, host and port to your local installation.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gearage
# Direct connection, used ONLY by Prisma migrations. For local Postgres it is the same URL.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/gearage
#
# Production (set in Vercel, NOT here), for Supabase:
#   DATABASE_URL = pooled/transaction connection string (port 6543, add ?pgbouncer=true)
#   DIRECT_URL   = direct connection string (port 5432), used by `prisma migrate deploy`

# Bearer secret for /api/cron/*. Generate: openssl rand -base64 48
CRON_SECRET=change-me-to-a-random-string-of-32-chars-or-more

# Dev/preview only: set to 1 to expose /{locale}/styleguide outside `next dev` (used by e2e on a production build).
ENABLE_STYLEGUIDE=0

# Image storage. Only "local" is implemented (writes under STORAGE_LOCAL_DIR, served from STORAGE_PUBLIC_BASE_URL).
# Production will use a hosted provider (Supabase Storage or Cloudinary) in M10a.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=public/uploads
STORAGE_PUBLIC_BASE_URL=/uploads

# The catalog is illustrative seed data, so pages show a "demo catalog" notice. Set to false ONLY at launch, after real
# prices are loaded and the flagged seed specs are verified (see HANDOFF "Launch blockers").
CATALOG_DEMO_NOTICE=true