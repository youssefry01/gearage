    "@prisma/client": "7.10.1",
    "@upstash/redis": "1.41.0",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "better-auth": "1.7.17",
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "next-safe-action": "8.7.3",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
