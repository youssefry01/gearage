{
  "name": "gearage",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-preflight.mjs && playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "tokens:build": "tsx scripts/tokens.ts",
    "tokens:check": "tsx scripts/tokens.ts --check",
    "contrast": "tsx scripts/contrast.ts",
    "brand:check": "tsx scripts/check-brand.ts",
    "brand:assets": "tsx scripts/brand-assets.ts",
    "i18n:review": "tsx scripts/list-arabic.ts",
    "i18n:review:check": "tsx scripts/list-arabic.ts --check",
    "test:db": "vitest run --config vitest.db.config.mts",
    "seed:docs": "tsx scripts/seed-docs.ts",
    "seed:docs:check": "tsx scripts/seed-docs.ts --check",
    "search:try": "tsx scripts/search-try.ts",
    "auth:bench": "tsx scripts/argon2-bench.ts",
    "email:test": "tsx scripts/email-test.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
