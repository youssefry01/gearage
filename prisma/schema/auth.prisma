// Authentication (M5a-2, ADR 0002): the four tables Better Auth needs (user, session, account, verification) plus the
// per-account login lockout. The Better Auth tables follow ITS schema (field names and types are not ours to change);
// our additions are the profile and consent columns on `user`, UUIDv7 ids (generated by the database, so
// `advanced.database.generateId` is false) and the project convention that timestamps are set by code, never by a
// database default (HANDOFF "Time zones").

enum Gender {
  MALE
  FEMALE
}

model User {
  id            String   @id @default(uuid(7)) @db.Uuid
  /// "First Last" (Better Auth requires a display name).
  name          String
  /// Always stored lower-cased by Better Auth.
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  firstName   String
  lastName    String
  /// Egyptian mobile in E.164 (+20...). Not unique on purpose: a unique phone would be a second way to probe for accounts.
  phone       String
  dateOfBirth DateTime? @db.Date
  gender      Gender?
  /// Language of the page the account was created from; used for emails sent without a request.
  locale      String    @default("en")

  /// Consent evidence (Personal Data Protection Law 151/2020): what was accepted, which version of the text, when.
  termsAcceptedAt    DateTime
  termsVersion       String
  privacyAcceptedAt  DateTime
  privacyVersion     String
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?

  sessions           Session[]
  accounts           Account[]
  securityEvents     SecurityEvent[]
  emailChangeRequest EmailChangeRequest?
  emailChangeReverts EmailChangeRevert[]

  @@map("user")
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime
  /// Opaque random token; the cookie holds it signed with AUTH_SECRET.
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  /// Better Auth's own columns. We never store an IP address or the raw User-Agent: both are always NULL (M5b-1, ADR 0025).
  ipAddress String?
  userAgent String?
  /// Coarse device label derived from the User-Agent at sign-in, as `<browser>/<os>` codes such as `chrome/windows`
  /// (a CHECK keeps it to that shape). The sessions list turns it into "Chrome on Windows" in the page language.
  device    String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// For the "credential" provider: `pv<pepper version>:<Argon2id PHC string>` (ADR 0003).
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

/// One-time values: email codes (stored hashed with an attempt counter) and password-reset tokens.
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime
  updatedAt  DateTime

  @@index([identifier])
  @@map("verification")
}

/// Progressive login lockout (ADR 0024). Keyed by an HMAC of the normalized email, so a login for an address that has
/// no account is throttled exactly like one that has (no account enumeration). Holds no email address.
model LoginThrottle {
  key           String    @id
  failures      Int
  lockedUntil   DateTime?
  lastFailureAt DateTime

  @@index([lastFailureAt])
  @@map("login_throttle")
}

enum SecurityEventType {
  SIGN_IN
  PASSWORD_CHANGED
  PASSWORD_RESET
  SESSION_REVOKED
  OTHER_SESSIONS_REVOKED
  EMAIL_CHANGE_REQUESTED
  EMAIL_CHANGE_CANCELLED
  EMAIL_CHANGED
  EMAIL_CHANGE_REVERTED
}

/// The account's security activity (M5b-1, ADR 0025): what happened and when, nothing else. Sign-in events also carry
/// the same coarse device label as the session (a CHECK allows it on no other type). No IP address, no raw User-Agent,
/// no free-form metadata. Rows older than SECURITY_EVENT_RETENTION_DAYS are deleted by the daily `prune-auth-data` job.
model SecurityEvent {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @db.Uuid
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      SecurityEventType
  /// `<browser>/<os>` codes, SIGN_IN events only.
  device    String?
  createdAt DateTime

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("security_event")
}

/// A pending email change (M5b-2a, ADR 0026): at most one per account. The code that proves control of the NEW address and
/// the token in the "cancel" link sent to the CURRENT address are stored only as HMACs (a database leak alone cannot
/// replay either). The same row exists whether or not the new address already belongs to an account, so nothing in
/// the database or the responses tells the two cases apart. Expired rows are deleted by the daily `prune-auth-data` job.
model EmailChangeRequest {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @unique @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Normalized (trimmed, lower-case) address the account wants to move to.
  newEmail   String
  /// HMAC-SHA256 (hex) of the 6-digit code, bound to the account and the new address.
  codeHash   String
  /// HMAC-SHA256 (hex) of the cancel token.
  cancelHash String   @unique
  /// Wrong codes so far; the request is destroyed at EMAIL_CHANGE_MAX_ATTEMPTS.
  attempts   Int      @default(0)
  expiresAt  DateTime
  createdAt  DateTime

  @@index([expiresAt])
  @@map("email_change_request")
}

/// The way back after an email change completed (M5b-2a follow-up, ADR 0027). Created in the same transaction as the
/// change; it RESERVES the old address for EMAIL_REVERT_DAYS (nobody can register it or move another account to it; those
/// attempts follow the ordinary "taken" path) and holds the single-use token in the link sent to the old address, stored
/// only as an HMAC. `oldEmail` is unique: one reservation per address at a time. Expired rows are deleted by the daily
/// `prune-auth-data` job.
model EmailChangeRevert {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Normalized address the account had before the change: what a revert restores, and what is reserved.
  oldEmail  String   @unique
  /// Normalized address the account moved to (for the notices; the revert releases whatever the account holds then).
  newEmail  String
  /// HMAC-SHA256 (hex) of the revert token.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime

  @@index([userId])
  @@index([expiresAt])
  @@map("email_change_revert")
}
